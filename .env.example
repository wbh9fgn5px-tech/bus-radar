# ─── Bus Radar France — variables d'environnement ───
# Aucune variable n'est obligatoire : sans configuration, l'application
# interroge les flux publics du catalogue transport.data.gouv.fr.
# Les variables NEXT_PUBLIC_* sont les SEULES exposées au navigateur.

# Ingestion
POLL_INTERVAL_SEC=20          # intervalle d'interrogation des flux GTFS-RT
MIN_POLL_INTERVAL_SEC=10      # plancher (protection des producteurs)
FETCH_CONCURRENCY=8           # requêtes simultanées max
LIVE_MAX_AGE_SEC=180          # au-delà : "position ancienne"
DROP_AFTER_SEC=900            # au-delà : véhicule retiré de la carte
CATALOG_REFRESH_HOURS=6
# ONLY_SOURCES=pan-xxx,pan-yyy  # restreindre à certaines sources (debug)

# GTFS statique (enrichissement : lignes, destinations, arrêts)
LOAD_STATIC_GTFS=true
STATIC_MAX_ZIP_MB=80
STATIC_REFRESH_HOURS=24
DATA_DIR=.data                # cache disque (catalogue, GTFS, géocodage)

# Historique persistant (optionnel) — PostgreSQL + PostGIS, schéma : db/schema.sql
# DATABASE_URL=postgres://user:pass@host:5432/busradar

# Sources à identifiants (voir config/credentialed-sources.example.json)
# EXEMPLE_SIRI_API_KEY=

# Déploiement séparé frontend (ex. Vercel) / backend
# NEXT_PUBLIC_API_BASE=https://api.busradar.example   # côté frontend
# CORS_ORIGIN=https://busradar.example                # côté backend

# Fonds de carte (OpenFreeMap par défaut, sans clé)
# NEXT_PUBLIC_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
# NEXT_PUBLIC_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
# ENGINE_AUTOSTART=true
STATIC_CONCURRENCY=2          # imports GTFS simultanés
